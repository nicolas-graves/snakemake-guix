+            legacy_conda_env="env.yaml",
+        )
+        result = specs.interpret()
+        assert isinstance(result, EnvModuleEnvSpec)
+        assert result.fallback is not None
+        assert isinstance(result.fallback, CondaEnvSpec)
+
