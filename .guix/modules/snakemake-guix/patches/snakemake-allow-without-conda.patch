From 9b59cf8761942085c6249723353924672eb1fc7e Mon Sep 17 00:00:00 2001
From: Nicolas Graves <ngraves@ngraves.fr>
Subject: [PATCH] Allow using Snakemake without the Conda plugin

---
 src/snakemake/cwl.py                     | 6 +++++-
 src/snakemake/deployment/__init__.py     | 5 ++++-
 src/snakemake/deployment/containerize.py | 7 +++++--
 src/snakemake/jobs.py                    | 7 +++++--
 src/snakemake/wrapper.py                 | 5 ++++-
 5 files changed, 23 insertions(+), 7 deletions(-)

diff --git a/src/snakemake/cwl.py b/src/snakemake/cwl.py
index 668ad88a..0d4c7c51 100644
--- a/src/snakemake/cwl.py
+++ b/src/snakemake/cwl.py
@@ -18,7 +18,10 @@ from snakemake_interface_executor_plugins.settings import ExecMode
 from snakemake_interface_software_deployment_plugins import EnvBase
 from snakemake_software_deployment_plugin_container import Settings as ContainerSettings
 from snakemake_software_deployment_plugin_container import Runtime as ContainerRuntime
-from snakemake_software_deployment_plugin_conda import EnvSpec as CondaEnvSpec
+try:
+    from snakemake_software_deployment_plugin_conda import EnvSpec as CondaEnvSpec
+except ImportError:
+    CondaEnvSpec = None
 from snakemake.executors.local import RunArgs
 
 
@@ -98,6 +101,7 @@ def job_to_cwl(job, dag, outputs, inputs):
     files = [f for f in job.input if f not in dep_ids]
     if (
         job.software_env_spec is not None
+        and CondaEnvSpec is not None
         and isinstance(job.software_env_spec, CondaEnvSpec)
         and job.job.software_env_spec.envfile is not None
     ):
diff --git a/src/snakemake/deployment/__init__.py b/src/snakemake/deployment/__init__.py
index 876eb371..67004c67 100644
--- a/src/snakemake/deployment/__init__.py
+++ b/src/snakemake/deployment/__init__.py
@@ -26,7 +26,10 @@ from snakemake_interface_software_deployment_plugins import (
     ShellExecutable,
 )
 from snakemake.common import get_function_params, overwrite_function_params
-from snakemake_software_deployment_plugin_conda import EnvSpec as CondaEnvSpec
+try:
+    from snakemake_software_deployment_plugin_conda import EnvSpec as CondaEnvSpec
+except ImportError:
+    CondaEnvSpec = None
 from snakemake_software_deployment_plugin_container import EnvSpec as ContainerEnvSpec
 from snakemake_software_deployment_plugin_envmodules import EnvSpec as EnvModuleEnvSpec
 
diff --git a/src/snakemake/deployment/containerize.py b/src/snakemake/deployment/containerize.py
index e4e96a20..08f057e6 100644
--- a/src/snakemake/deployment/containerize.py
+++ b/src/snakemake/deployment/containerize.py
@@ -6,7 +6,10 @@ from abc import ABC, abstractmethod
 from snakemake.exceptions import WorkflowError
 from snakemake.logging import logger
 from snakemake.sourcecache import LocalSourceFile
-from snakemake_software_deployment_plugin_conda import EnvSpec as CondaEnvSpec
+try:
+    from snakemake_software_deployment_plugin_conda import EnvSpec as CondaEnvSpec
+except ImportError:
+    CondaEnvSpec = None
 
 
 # TODO convert to rattler or pixi?
@@ -179,7 +182,7 @@ def containerize(workflow, dag, fmt="dockerfile"):
 
     # collect envs from jobs from the initial DAG.
     def is_conda_job(job):
-        return job.software_env_spec is not None and isinstance(
+        return CondaEnvSpec is not None and job.software_env_spec is not None and isinstance(
             job.software_env_spec, CondaEnvSpec
         )
 
diff --git a/src/snakemake/jobs.py b/src/snakemake/jobs.py
index f04d9345..adace690 100644
--- a/src/snakemake/jobs.py
+++ b/src/snakemake/jobs.py
@@ -74,7 +74,10 @@ from snakemake_interface_software_deployment_plugins import EnvBase as SoftwareE
 from snakemake_interface_software_deployment_plugins import (
     EnvSpecBase as SoftwareEnvSpecBase,
 )
-from snakemake_software_deployment_plugin_conda import Env as CondaEnv
+try:
+    from snakemake_software_deployment_plugin_conda import Env as CondaEnv
+except ImportError:
+    CondaEnv = None
 
 
 def format_files(io, as_input: bool = False, as_output: bool = False):
@@ -524,7 +527,7 @@ class Job(
             env = self.dag.workflow.software_deployment_manager.get_env(
                 self.software_env_spec
             )
-            if self.rule.is_containerized and isinstance(env, CondaEnv):
+            if self.rule.is_containerized and CondaEnv is not None and isinstance(env, CondaEnv):
                 env.containerized_path = get_containerized_path(env)
             return env
         return None
diff --git a/src/snakemake/wrapper.py b/src/snakemake/wrapper.py
index 2d48b64b..026785e3 100644
--- a/src/snakemake/wrapper.py
+++ b/src/snakemake/wrapper.py
@@ -14,7 +14,10 @@ from typing import Optional
 from snakemake.exceptions import WorkflowError
 from snakemake.script import script
 from snakemake.sourcecache import GithubFile, SourceCache, infer_source_file
-from snakemake_software_deployment_plugin_conda import EnvSpec as CondaEnvSpec
+try:
+    from snakemake_software_deployment_plugin_conda import EnvSpec as CondaEnvSpec
+except ImportError:
+    CondaEnvSpec = None
 from snakemake_interface_software_deployment_plugins import EnvSpecSourceFile
 
 EXTENSIONS = [".py", ".R", ".Rmd", ".jl"]
